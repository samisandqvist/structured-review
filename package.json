{
  "name": "structured-review",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @srev/server dev\" \"pnpm --filter @srev/web dev\"",
    "build": "pnpm -r build",
    "build:plugin": "node scripts/build-plugin.mjs",
    "start": "pnpm --filter @srev/server start",
    "demo": "node scripts/demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:harness",
    "verify": "node scripts/harness/verify.mjs",
    "verify:strict": "node scripts/harness/verify.mjs --strict",
    "verify:full": "node scripts/harness/verify.mjs --full",
    "lint": "node scripts/harness/check-static.mjs",
    "lint:strict": "node scripts/harness/check-static.mjs --strict",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,css}\" \"packages/*/test/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"tests/**/*.{ts,mjs}\" \"*.config.{ts,mjs}\" \".dependency-cruiser.cjs\" \"*.json\" \".harness/*.json\"",
    "architecture": "depcruise packages/*/src --output-type err-long",
    "test:coverage": "vitest run --coverage",
    "coverage:check": "node scripts/harness/check-coverage.mjs --changed",
    "coverage:strict": "node scripts/harness/check-coverage.mjs --strict --changed",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "plugin:check": "node scripts/harness/check-artifacts.mjs",
    "security:setup": "bash scripts/security/setup-tools.sh",
    "security:update": "bash scripts/security/update-advisories.sh",
    "security:check": "bash scripts/security/check.sh",
    "security:probe": "bash scripts/security/probe.sh",
    "test:harness": "vitest run --config tests/harness/vitest.config.ts",
    "typecheck:harness": "tsc --noEmit -p tsconfig.harness.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "3.2.6",
    "concurrently": "^9.1.0",
    "dependency-cruiser": "18.2.0",
    "esbuild": "^0.28.1",
    "eslint": "9.39.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "fast-check": "4.10.0",
    "globals": "16.5.0",
    "knip": "6.35.1",
    "prettier": "3.6.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.70.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "brace-expansion@1.1.16": "1.1.18",
      "browserslist@4.28.2": "4.28.7",
      "fast-uri@3.1.2": "3.1.6",
      "ip-address@10.2.0": "10.3.1",
      "nanoid@3.3.14": "3.3.18",
      "postcss@8.5.15": "8.5.18",
      "shell-quote@1.8.4": "1.9.0"
    }
  }
}
