{
  "name": "@crw/server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').copyFileSync('src/graph/scip.proto','dist/graph/scip.proto')\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sourcegraph/scip-python": "^0.6.6",
    "@sourcegraph/scip-typescript": "^0.4.0",
    "hono": "^4.13.7",
    "protobufjs": "^8.8.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
