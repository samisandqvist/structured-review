{
  "name": "@srev/server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').copyFileSync('src/graph/scip.proto','dist/graph/scip.proto')\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sourcegraph/scip-python": "^0.6.8",
    "@sourcegraph/scip-typescript": "^0.5.2",
    "hono": "^4.13.14",
    "protobufjs": "^8.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
